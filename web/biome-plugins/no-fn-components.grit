// Enforce arrow-const React component style.
// Flags top-level PascalCase `function` declarations (plain / export / export default).
// Biome's built-in `useArrowFunction` cannot do this (it never touches declarations).
language js

or {
  `export default function $name($args) { $body }`,
  `function $name($args) { $body }`
} as $fn where {
  $name <: r"^[A-Z][A-Za-z0-9]*$",
  register_diagnostic(
    span = $fn,
    message = "React components must be arrow-function consts (`const X = () => {}`), not `function` declarations."
  )
}

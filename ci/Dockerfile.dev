# codefort CI *dev* image — the toolchain image codefort's own codefort.yml runs on.
#
# The base image (ci/Dockerfile, codefort-ci:latest) is deliberately
# toolchain-free; this derives from it and adds the Go + Node toolchains
# codefort's pipeline needs (go build/test/vet/fmt, web build) plus the
# static-analysis toolchain the go-quality gate shells out to. It still
# carries provision + mooncake + git from the base — provision is what the
# runner execs inside the container (#411); mooncake stays for the `quality`
# job's own `mooncake task ci` shell-out.
#
# `mooncake task ci` (go-quality module) runs golangci-lint/govulncheck/gocyclo/
# dupl, so those are baked here at pinned versions; dupl-report.sh pipes through
# python3, so python3 is installed too. goda is optional (the gate skips it).
#
# Pin toolchains via official tarballs (apt's Go lags codefort's go.mod). Jobs
# run as the codefortd uid:gid with no home dir, so HOME/GOCACHE/GOPATH point at
# world-writable /tmp — otherwise go/npm can't write their caches. The
# build-time module/build caches are wiped after `go install` so runtime jobs
# recreate them under their own uid (root-owned cache dirs would be unwritable).
#
# Build (from the codefort repo root, after codefort-ci:latest exists):
#   docker build -t codefort-ci-dev:latest -f ci/Dockerfile.dev ci/
FROM codefort-ci:latest

ARG GO_VERSION=1.26.4
ARG NODE_VERSION=22.21.0

# Static-analysis tool versions — pinned to match the host toolchain so CI and
# the local pre-push gate flag the same findings. Bump deliberately.
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GOVULNCHECK_VERSION=v1.3.0
ARG GOCYCLO_VERSION=v0.6.0
ARG DUPL_VERSION=v1.1.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg python3 \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && chmod a+r /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli gcc libc6-dev \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -C /usr/local -xz \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
      | tar -C /usr/local --strip-components=1 -xz \
 && apt-get purge -y curl gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/local/go/bin:$PATH \
    HOME=/tmp \
    GOCACHE=/tmp/.cache/go-build \
    GOPATH=/tmp/go \
    GOTOOLCHAIN=local \
    GOPROXY=https://proxy.golang.org,https://goproxy.io,direct

# Install the static-analysis toolchain onto PATH, then wipe the build-time
# caches so runtime jobs (codefortd uid) own the cache dirs they recreate.
# CGO_ENABLED=0: these tools are pure Go; no C deps needed at install time.
RUN CGO_ENABLED=0 GOBIN=/usr/local/bin go install \
      "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
 && CGO_ENABLED=0 GOBIN=/usr/local/bin go install \
      "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}" \
 && CGO_ENABLED=0 GOBIN=/usr/local/bin go install \
      "github.com/fzipp/gocyclo/cmd/gocyclo@${GOCYCLO_VERSION}" \
 && CGO_ENABLED=0 GOBIN=/usr/local/bin go install \
      "github.com/mibk/dupl@${DUPL_VERSION}" \
 && go clean -cache -modcache \
 && rm -rf /tmp/go /tmp/.cache

RUN go version && node --version && provision --version && mooncake --version && python3 --version && docker --version \
 && for t in golangci-lint govulncheck gocyclo dupl; do \
      command -v "$t" >/dev/null || { echo "missing tool: $t" >&2; exit 1; }; \
    done

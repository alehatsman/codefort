# Paths dex should not index. Kept separate from .gitignore so these stay
# tracked in git while staying out of the semantic index.

# Dependency lockfile — huge, pure noise for code intel.
web/package-lock.json

# Playwright output: failure screenshots, traces and error-context.md dumps.
# Regenerated on every test run and full of stale UI snapshots — noise.
web/test-results/
web/playwright-report/

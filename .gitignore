# Mooncake — local state and plan artifacts
.mooncake/
*.plan.json
*.plan.yaml

# Go build artifacts
/bin/
/moongitd
/moongit
*.test
*.out

# Generated architecture snapshot (go-quality arch-snapshot; local, read-only)
/docs-working/

# Runtime data (SQLite db, bare repos)
/data/

# Agent worktrees + local Claude state (also keeps dex from indexing stale
# worktree copies of the repo).
.claude/

# Agent image build inputs (binaries, not source) — see agent/README.md
agent/dex
agent/mgit
agent/mooncake

.playwright-mcp

# dex: ignore the local index cache / generated artifacts but track the
# committed opt-in config so a fresh checkout/reindex keeps a populated
# index (dex indexes nothing without an [index].include list).
.dex/*
!.dex/config.toml
